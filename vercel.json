{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|anatomy/|vendor/|src/|utils/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/feedback.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
